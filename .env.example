# Copy this file to .env and fill in your settings:
#   cp .env.example .env
#
# Create a token at https://github.com/settings/tokens
# Scopes: repo (private repos) or public_repo (public repos only)
GITHUB_TOKEN=ghp_your_token_here

# GitHub username or org to back up (optional if --user is passed)
GITHUB_USER=octocat

# Comma-separated list of repos to back up (empty = all)
GITHUB_REPOS=repo-a,repo-b

# Fetch Git LFS objects during backup (true/false). Requires git-lfs installed.
GITHUB_LFS=true

# Export a readable working-copy snapshot of each repo (true/false, default true)
SNAPSHOT=true

# Comma-separated directory names excluded from snapshots (unset = defaults)
EXCLUDE_DIRS=node_modules,.venv,venv,env,site-packages,__pycache__,dist,build,.next,.astro,out,target,vendor,.cache
